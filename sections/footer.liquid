{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_bio",
      "label": "Brand Description",
      "default": "BALURIX - علامة مغربية رائدة في حلول العناية الطبيعية الفاخرة المعتمدة على خلاصات نباتية وببتيدات متطورة لصحة ونضارة تدوم."
    },
    {
      "type": "text",
      "id": "support_phone",
      "label": "Customer Support Phone",
      "default": "+212 636 460 996"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support Email",
      "default": "contact@balurix.ma"
    }
  ]
}
{% endschema %}

<footer class="balurix-footer">
  <div class="balurix-container footer-inner">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-col brand-col">
        <a href="/" class="balurix-logo footer-logo">
          <span class="logo-mark">B</span>
          <div class="logo-text">
            <span class="logo-name">BALURIX</span>
            <span class="logo-sub">NATURAL CARE</span>
          </div>
        </a>
        <p class="footer-desc">{{ section.settings.brand_bio }}</p>
        
        <div class="footer-trust-badges">
          <span class="badge-pill">🌿 مكونات نباتية 100%</span>
          <span class="badge-pill">🔬 فحص مخبري معتمد</span>
          <span class="badge-pill">🇲🇦 توصيل سريع بالمغرب</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-col">
        <h4 class="footer-title">روابط سريعة</h4>
        <ul class="footer-links">
          <li><a href="/">الصفحة الرئيسية</a></li>
          <li><a href="/collections/all">جميع المنتجات</a></li>
          <li><a href="/products/chlorophyll-drops">قطرات الكلوروفيل المركز</a></li>
          <li><a href="/pages/about">عن مختبرات BALURIX</a></li>
          <li><a href="/pages/faq">الأسئلة الشائعة</a></li>
        </ul>
      </div>

      <!-- Customer Service & Guarantees -->
      <div class="footer-col">
        <h4 class="footer-title">خدمة العملاء والضمان</h4>
        <ul class="footer-links">
          <li><a href="/pages/shipping">الشحن وسياسة التوصيل</a></li>
          <li><a href="/pages/returns">سياسة الاستبدال والاسترجاع</a></li>
          <li><a href="/pages/privacy">سياسة الخصوصية والأمان</a></li>
          <li><a href="/pages/terms">الشروط والأحكام</a></li>
          <li><a href="/pages/cod-info">كيف يعمل الدفع عند الاستلام؟</a></li>
        </ul>
      </div>

      <!-- Contact & WhatsApp COD -->
      <div class="footer-col contact-col">
        <h4 class="footer-title">تواصل معنا & الطلب السريع</h4>
        <p class="contact-hint">فريقنا متواجد 7/7 للإجابة عن أسئلتكم ومتابعة طلباتكم بكل اهتمام:</p>
        <div class="contact-details">
          <a href="tel:{{ section.settings.support_phone | replace: ' ', '' }}" class="contact-link">
            📞 {{ section.settings.support_phone }}
          </a>
          <a href="mailto:{{ section.settings.support_email }}" class="contact-link">
            ✉️ {{ section.settings.support_email }}
          </a>
        </div>
        <div class="cod-reassurance-box">
          <span class="cod-icon">🛡️</span>
          <div>
            <strong>معاينة قبل الدفع</strong>
            <p>لا تدفع أي سنتيم حتى يصلك الموزع لباب بيتك وتتحقق من سلامة عبوتك.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {{ 'now' | date: "%Y" }} BALURIX Natural Care. جميع الحقوق محفوظة. علامة تجارية مسجلة.
      </p>
      <div class="payment-methods-text">
        <span>الدفع نقداً عند الاستلام (COD) متاح في 100+ مدينة وقرية مغربية 🇲🇦</span>
      </div>
    </div>
  </div>
</footer>
